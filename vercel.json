{
  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "tonconnect-manifest.json",
      "use": "@vercel/static"
    },
    {
      "src": "1795016818399.jpg",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/api/(.*)$",
      "dest": "main.py"
    },
    {
      "src": "^/webhook$",
      "dest": "main.py"
    },
    {
      "src": "^/tonconnect-manifest\\.json$",
      "headers": {
        "Cache-Control": "public, max-age=300, must-revalidate"
      },
      "dest": "/tonconnect-manifest.json"
    },
    {
      "src": "^/1795016818399\\.jpg$",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      },
      "dest": "/1795016818399.jpg"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "^/(.*)$",
      "dest": "main.py"
    }
  ]
}
