{
  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "tonconnect-manifest.json",
      "use": "@vercel/static"
    },
    {
      "src": "1795016818399.jpg",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/tonconnect-manifest.json",
      "dest": "/tonconnect-manifest.json"
    },
    {
      "src": "/1795016818399.jpg",
      "dest": "/1795016818399.jpg"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "main.py"
    }
  ]
}
